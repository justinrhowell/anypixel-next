{
  "name": "anypixel-next",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Design guidance and review tools for coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "anypixel-next": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./sdk": "./dist/sdk/index.js"
  },
  "files": [
    "dist",
    "packs",
    "schemas",
    "README.md",
    "LICENSE",
    "NOTICE",
    "examples/custom-check",
    "examples/dense-product-ui",
    "CONTRIBUTING.md",
    "docs",
    "SECURITY.md",
    "GOVERNANCE.md",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "extensions/web"
  ],
  "scripts": {
    "build": "tsc && node scripts/schemas.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node scripts/test-browser.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepack": "npm run build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm test && git diff --exit-code -- schemas"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "picomatch": "4.0.7",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.1",
    "@types/picomatch": "4.0.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinrhowell/anypixel-next.git"
  },
  "homepage": "https://github.com/justinrhowell/anypixel-next#readme",
  "bugs": {
    "url": "https://github.com/justinrhowell/anypixel-next/issues"
  }
}
