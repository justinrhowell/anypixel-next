{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(ctx|cap|rev|dec)_[0-9a-f-]{36}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    },
    "contextId": {
      "type": "string",
      "pattern": "^(ctx|cap|rev|dec)_[0-9a-f-]{36}$"
    },
    "captureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(ctx|cap|rev|dec)_[0-9a-f-]{36}$"
      }
    },
    "baseReviewId": {
      "type": "string",
      "pattern": "^(ctx|cap|rev|dec)_[0-9a-f-]{36}$"
    },
    "comparison": {
      "type": "string",
      "minLength": 1
    },
    "ci": {
      "type": "boolean"
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "enum": [
              "measured",
              "inferred",
              "human"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "goalRelevance": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proposedAction": {
            "type": "string",
            "minLength": 1
          },
          "uncertainty": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "author",
          "category",
          "basis",
          "priority",
          "claim",
          "goalRelevance",
          "evidence",
          "proposedAction",
          "uncertainty"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "captureId": {
            "type": "string",
            "minLength": 1
          },
          "extension": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "result": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "completed",
                  "not_applicable",
                  "not_assessed",
                  "error",
                  "cancelled"
                ]
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "author": {
                      "type": "string",
                      "minLength": 1
                    },
                    "category": {
                      "type": "string",
                      "minLength": 1
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "measured",
                        "inferred",
                        "human"
                      ]
                    },
                    "priority": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1
                    },
                    "goalRelevance": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "proposedAction": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uncertainty": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "author",
                    "category",
                    "basis",
                    "priority",
                    "claim",
                    "goalRelevance",
                    "evidence",
                    "proposedAction",
                    "uncertainty"
                  ],
                  "additionalProperties": false
                }
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "status",
              "findings",
              "limitations"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "check",
          "captureId",
          "extension",
          "version",
          "options",
          "durationMs",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "toolVersion",
    "contextId",
    "captureIds",
    "comparison",
    "ci",
    "exitCode",
    "findings",
    "coverage",
    "limitations"
  ],
  "additionalProperties": false
}
