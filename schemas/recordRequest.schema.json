{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\/[a-z][a-z0-9-]*$"
    },
    "scope": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "default": "proposed",
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^(ctx|cap|rev|dec)_[0-9a-f-]{36}$"
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "actor",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "key",
    "scope",
    "status",
    "text",
    "reason",
    "evidence"
  ],
  "additionalProperties": false
}
