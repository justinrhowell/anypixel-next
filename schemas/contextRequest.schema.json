{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "default": ".",
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "default": 12000,
      "type": "integer",
      "minimum": 1000,
      "maximum": 100000
    }
  },
  "required": [
    "task",
    "scope",
    "budget"
  ],
  "additionalProperties": false
}
