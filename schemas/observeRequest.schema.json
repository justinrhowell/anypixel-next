{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "observer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\/[a-z][a-z0-9-]*$"
    },
    "input": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "observer",
    "input"
  ],
  "additionalProperties": false
}
